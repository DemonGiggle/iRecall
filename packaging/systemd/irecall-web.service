[Unit]
Description=iRecall web API server
After=network.target

[Service]
Type=simple
User=irecall
Group=irecall
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# Default data path; can be overridden in the environment file.
Environment=IRECALL_DATA_PATH=/var/lib/irecall
# Default bind address; keep local-only unless you intentionally expose the API.
Environment=IRECALL_WEB_HOST=127.0.0.1
# OpenAI-compatible provider defaults; override in /etc/irecall/irecall-web.env.
Environment=IRECALL_PROVIDER_HOST=localhost
Environment=IRECALL_PROVIDER_PORT=11434
Environment=IRECALL_PROVIDER_HTTPS=false
Environment=IRECALL_PROVIDER_API_KEY_PATH=/etc/irecall/provider-api-key
Environment=IRECALL_PROVIDER_MODEL=
# Optional environment file; create /etc/irecall/irecall-web.env to override values
EnvironmentFile=-/etc/irecall/irecall-web.env
# Run headless API-only (perform initial interactive setup manually if needed)
ExecStart=/usr/local/bin/irecall-web --api-only --host=${IRECALL_WEB_HOST} --data-path=${IRECALL_DATA_PATH} --provider-host=${IRECALL_PROVIDER_HOST} --provider-port=${IRECALL_PROVIDER_PORT} --provider-https=${IRECALL_PROVIDER_HTTPS} --provider-api-key-path=${IRECALL_PROVIDER_API_KEY_PATH} --provider-model=${IRECALL_PROVIDER_MODEL}
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/irecall
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
